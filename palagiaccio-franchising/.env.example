# Endpoint che riceve le richieste del modulo franchising (POST JSON).
# Se lasciato vuoto, il modulo funziona in "modalità anteprima": valida i campi
# ma NON invia alcun dato e lo dichiara apertamente all'utente.
VITE_LEAD_ENDPOINT=

# Mostra in pagina i contrassegni "DA VALIDARE" sui dati economici anche nella build
# (in sviluppo sono sempre visibili). Da lasciare false in produzione.
VITE_SHOW_REVIEW_FLAGS=false

# URL pubblico della landing, usato per i metadati Open Graph (senza slash finale).
VITE_SITE_URL=
